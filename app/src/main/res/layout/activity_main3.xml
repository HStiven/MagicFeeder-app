<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context="FirstApp.MainActivity3">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/titu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sniglet"
                android:gravity="center_horizontal"
                android:text="@string/titu"
                android:textColor="@color/black"
                android:textSize="30dp"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="2dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    app:srcCompat="@drawable/perromegapeque" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra"
                    android:layout_width="220dp"
                    android:layout_height="110dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Una perra pequeña necesita entre 100 y 200 gramos de alimento seco de alta calidad al día, dividido en dos porciones (mañana y tarde)."
                    android:textAlignment="textEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:layout_marginTop="10dp"
                    tools:ignore="MissingConstraints" />
            </LinearLayout>

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra2"
                android:layout_width="320dp"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/agrandirregular"
                android:text="En cuanto al agua, necesita entre 40 y 60 mililitros por kilogramo de peso corporal."
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginEnd="-14dp"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="8dp"
                    app:srcCompat="@drawable/perritopeque" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra3"
                    android:layout_width="220dp"
                    android:layout_height="130dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Una perra mediana, el requerimiento diario de alimento es de aproximadamente 200 a 400 gramos, según su peso, actividad y edad. "
                    android:textAlignment="textEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:layout_marginTop="10dp"
                    tools:ignore="MissingConstraints" />
            </LinearLayout>

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra4"
                android:layout_width="320dp"
                android:layout_height="70dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/agrandirregular"
                android:text="En cuanto al agua, el consumo recomendado es de 40 a 60 mililitros por kilogramo de peso corporal."
                android:textAlignment="textEnd"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginEnd="-14dp"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="7dp"
                    app:srcCompat="@drawable/perromediano" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra5"
                    android:layout_width="220dp"
                    android:layout_height="109dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Una perra hembra, la cantidad diaria de comida seca de alta calidad suele estar entre 300 y 600 gramos."
                    android:textAlignment="textEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:layout_marginTop="10dp"
                    tools:ignore="MissingConstraints" />
            </LinearLayout>

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra6"
                android:layout_width="320dp"
                android:layout_height="105dp"
                android:fontFamily="@font/agrandirregular"
                android:text="Divide la comida en dos porciones al día, una por la mañana y otra por la noche. En cuanto al agua, se recomienda entre 40 y 60 mililitros por kilogramo de peso corporal."
                android:textAlignment="textEnd"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginEnd="-14dp"
                tools:ignore="MissingConstraints" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Texto explicativo -->

                <!-- Tabla de guía de dosificación -->
                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra7"
                    android:layout_width="320dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="22dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Consulta la tabla a continuación para ajustar el tiempo del dispensador según el tamaño de las croquetas y la cantidad de comida que necesites."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TableLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/letra7"
                    android:layout_margin="25dp"
                    android:stretchColumns="*">

                    <!-- Encabezado de la tabla -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Tiempo"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Pequeña (g)"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Mediana (g)"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="Grande (g)"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                    <!-- Fila 1 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="5 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="15 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="20 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="20 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                    <!-- Fila 2 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="10 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="30 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="40 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="40 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                    <!-- Fila 3 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="15 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="45 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="60 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="60 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                    <!-- Fila 4 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="20 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="60 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="80 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="80 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>


                    <!-- Fila 5 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="30 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="90 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="120 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="120 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>


                    <!-- Fila 6 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="45 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="135 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="180 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="180 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                    <!-- Fila 7-->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="60 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="180 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="240 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="240 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>

                </TableLayout>

            </RelativeLayout>

        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>