<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="22dp"
    tools:context="FirstApp.MainActivity4">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/titu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sniglet"
                android:gravity="center_horizontal"
                android:text="@string/titu"
                android:textColor="@color/black"
                android:textSize="30dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                tools:ignore="MissingConstraints" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/titu"
                    app:srcCompat="@drawable/gatoo3" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra"
                    android:layout_width="220dp"
                    android:layout_height="90dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Para un gato pequeño, se recomienda alimentarlo con aproximadamente 30-40 gr de comida seca."
                    android:textAlignment="textEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.871"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/titu"
                    tools:ignore="MissingConstraints" />

            </LinearLayout>

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra2"
                android:layout_width="320dp"
                android:layout_height="88dp"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/agrandirregular"
                android:text="Su alimentación se puede dividir en dos comidas al día, acompañada de 150-200 ml de agua fresca dependiendo de su nivel de actividad, tamaño y peso."
                android:textAlignment="textEnd"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginEnd="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.413"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/letra"
                tools:ignore="MissingConstraints" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="5dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/letra4"
                    app:layout_constraintEnd_toStartOf="@+id/letra"
                    app:layout_constraintHorizontal_bias="0.545"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/letra2"
                    app:layout_constraintVertical_bias="1.0"
                    app:srcCompat="@drawable/gatoo1" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra3"
                    android:layout_width="220dp"
                    android:layout_height="80dp"
                    android:fontFamily="@font/agrandirregular"
                    android:text="Para un gato mediano, se recomienda alimentarlo con aproximadamente 40-50 gr de comida seca."
                    android:textAlignment="textEnd"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.870"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/letra2"
                    tools:ignore="MissingConstraints" />
            </LinearLayout>

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra4"
                android:layout_width="320dp"
                android:layout_height="88dp"
                android:fontFamily="@font/agrandirregular"
                android:text="Su alimentación se puede dividir en dos comidas al día, acompañada de 200-250 ml de agua fresca dependiendo de su nivel de actividad, tamaño y peso."
                android:textAlignment="textEnd"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:layout_marginEnd="-14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.31"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/letra3"
                tools:ignore="MissingConstraints" />

            <LinearLayout
