                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="40 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="40 g"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                    </TableRow>


                    <!-- Fila 5 -->
                    <TableRow>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="30 sg"
                            android:textColor="@color/black"
                            android:background="@drawable/border" />
                        <TextView
                            android:layout_width="wrap_content"
