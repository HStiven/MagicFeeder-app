                    android:id="@+id/imageView5"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="5dp"
                    app:layout_constraintBottom_toTopOf="@+id/letra6"
                    app:layout_constraintEnd_toStartOf="@+id/letra"
                    app:layout_constraintHorizontal_bias="0.454"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/letra4"
                    app:layout_constraintVertical_bias="0.0"
                    app:srcCompat="@drawable/gatoo2" />

                <me.biubiubiu.justifytext.library.JustifyTextView
                    android:id="@+id/letra5"
                    android:layout_width="220dp"
                    android:layout_height="90dp"
                    android:fontFamily="@font/agrandirregular"
