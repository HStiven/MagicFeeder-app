                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Tiempo"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Pequeña (g)"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Mediana (g)"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="Grande (g)"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>

                <!-- Fila 1 -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="5 sg"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="15 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="20 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        android:text="20 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>

                <!-- Fila 2 -->
