<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context="FirstApp.MainActivity2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/titu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sniglet"
            android:gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/titu"
            android:textColor="@color/black"
            android:textSize="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:gravity="center">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/titu"
            app:srcCompat="@drawable/perromegapeque"
            android:contentDescription="@string/small_dog_image_description" />

        <me.biubiubiu.justifytext.library.JustifyTextView
            android:id="@+id/letra"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:fontFamily="@font/agrandirregular"
            android:text="Un perro pequeño,  se elige una comida específica con croquetas de menor tamaño y se agrega comida húmeda para variedad."
            android:textColor="@color/black"
            android:textSize="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/imageView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageView" />
    </LinearLayout>

        <me.biubiubiu.justifytext.library.JustifyTextView
            android:id="@+id/letra2"
            android:layout_width="320dp"
            android:layout_height="91dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/agrandirregular"
            android:text="La porción recomendada es de 40 a 80 gramos, 2-3 veces al día. También necesitan beber alrededor de 60 ml de agua por kilogramo de peso corporal."
            android:textColor="@color/black"
            android:textSize="16dp"
            android:layout_marginEnd="-14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:gravity="center">

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/letra2"
            app:srcCompat="@drawable/perritopeque"
            android:contentDescription="@string/medium_dog_image_description" />

            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra3"
                android:layout_width="220dp"
                android:layout_height="81dp"
                android:fontFamily="@font/agrandirregular"
                android:text="Un perro mediano, debería consumir entre 250 y 350 gramos de comida al día, dividida en 2 o 3 comidas."
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imageView4"
                app:layout_constraintTop_toTopOf="@id/imageView4" />
        </LinearLayout>

        <me.biubiubiu.justifytext.library.JustifyTextView
            android:id="@+id/letra4"
            android:layout_width="320dp"
            android:layout_height="69dp"
            android:fontFamily="@font/agrandirregular"
            android:text="En cuanto al agua, la cantidad recomendada es de aproximadamente de 40 ml a 50 ml por kg de peso corporal."
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginEnd="-14dp"
            app:layout_constraintTop_toBottomOf="@+id/imageView4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="5dp"
            android:gravity="center">

        <ImageView
            android:id="@+id/imageView5"
            android:layout_width="115dp"
            android:layout_height="115dp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/letra4"
            app:srcCompat="@drawable/perromediano"
            android:contentDescription="@string/large_dog_image_description" />

        <me.biubiubiu.justifytext.library.JustifyTextView
            android:id="@+id/letra5"
            android:layout_width="220dp"
            android:layout_height="85dp"
            android:fontFamily="@font/agrandirregular"
            android:text="Un perro grande, necesita comer entre 300 y 600 gramos de alimento de buena calidad al día."
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toEndOf="@id/imageView5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imageView5" />
    </LinearLayout>

        <me.biubiubiu.justifytext.library.JustifyTextView
            android:id="@+id/letra6"
            android:layout_width="320dp"
            android:layout_height="90dp"
            android:fontFamily="@font/agrandirregular"
            android:text="En cuanto al agua  debería beber entre 40 y 60 mililitros por kilogramo de peso corporal. Su alimentacion se debe divir de 2-3  de comida al dia."
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginEnd="-14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView5" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Texto explicativo -->

            <!-- Tabla de guía de dosificación -->
            <me.biubiubiu.justifytext.library.JustifyTextView
                android:id="@+id/letra7"
                android:layout_width="320dp"
                android:layout_height="90dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="40dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="22dp"
                android:fontFamily="@font/agrandirregular"
                android:text="Consulta la tabla a continuación para ajustar el tiempo del dispensador según el tamaño de las croquetas y la cantidad de comida que necesites."
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TableLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/letra7"
                android:layout_margin="25dp"
                android:stretchColumns="*">

                <!-- Encabezado de la tabla -->
