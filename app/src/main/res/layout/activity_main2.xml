                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="60 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="60 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>

                <!-- Fila 4 -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="20 sg"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="60 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="80 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="80 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>


                <!-- Fila 5 -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="30 sg"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="90 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="120 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="120 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>


                <!-- Fila 6 -->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="45 sg"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="135 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="180 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="180 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>

                <!-- Fila 7-->
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="60 sg"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="180 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="240 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:text="240 g"
                        android:textColor="@color/black"
                        android:background="@drawable/border" />
                </TableRow>

            </TableLayout>

        </RelativeLayout>




    </LinearLayout>

    </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>